using Gtk 4.0;
using Adw 1;

menu palette_menu {
  section {
    item {
      label: "New palette…";
      action: "win.new-palette";
    }
    item {
      label: "Import palette…";
      action: "win.import-palette";
    }
    item {
      label: "Generate palette from image…";
      action: "win.generate-palette";
    }
    item {
      label: "Save palette as…";
      action: "win.save-palette-as";
    }
    item {
      label: "Configure palette generation…";
      action: "win.palette-generation-settings";
    }
    item {
      label: "Manage palettes…";
      action: "win.manage-palettes";
    }
    item {
      label: "Other…";
      action: "win.other-settings";
    }
  }
  section {
    item {
      label: "Auto-link hex/rgb";
      action: "win.auto-link-siblings";
    }
  }
  section {
    item {
      label: "Files to scan…";
      action: "win.scanned-files-settings";
    }
    item {
      label: "Post-apply scripts…";
      action: "win.restart-actions";
    }
    item {
      label: "Save detection snapshot…";
      action: "win.snapshot-detect";
    }
  }
}

Gtk.SizeGroup {
  mode: horizontal;
  widgets [detected_column, palette_column]
}

template $MainWindow: Adw.ApplicationWindow {
  default-width: 1150;
  default-height: 760;
  title: "Ultimate Color Switcher";

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle {
        title: "Ultimate Color Switcher";
        subtitle: "Color replacement in dotfiles";
      };

      [end]
      Gtk.MenuButton {
        menu-model: palette_menu;
        tooltip-text: "Palette, hex/rgb linking, post-apply scripts, snapshots and saved palette management";
        child: Adw.ButtonContent {
          icon-name: "view-more-symbolic";
          label: "Options";
        };
      }

      [end]
      Gtk.Button rescan_button {
        tooltip-text: "Re-scan the files for colors";
        child: Adw.ButtonContent {
          icon-name: "view-refresh-symbolic";
          label: "Scan";
        };
      }

      [end]
      Gtk.Button modifiers_button {
        sensitive: false;
        tooltip-text: "Change the palette's modifiers (saturation, complementary colors, regeneration) and preview";
        child: Adw.ButtonContent {
          icon-name: "applications-graphics-symbolic";
          label: "Modifiers";
        };
      }
    }

    content: Adw.ToastOverlay toast_overlay {
      Gtk.Box {
        orientation: vertical;

        Gtk.CenterBox {
          orientation: horizontal;
          vexpand: true;

          [start]
          Gtk.Box detected_column {
            orientation: vertical;
            hexpand: true;

            Gtk.Box {
              orientation: horizontal;
              margin-start: 12;
              margin-top: 10;
              margin-bottom: 4;
              margin-end: 6;

              Gtk.Label {
                label: "Detected colors";
                css-classes: ["heading"];
                xalign: 0;
                hexpand: true;
              }

              Gtk.ToggleButton detected_view_toggle {
                icon-name: "folder-symbolic";
                css-classes: ["flat"];
                tooltip-text: "Group by file instead of by occurrence count";
                valign: center;
              }
            }

            Gtk.SearchEntry detected_search_entry {
              placeholder-text: "Search color (hex, type or file)…";
              margin-start: 12;
              margin-end: 10;
              margin-bottom: 4;
            }

            Gtk.ScrolledWindow {
              height-request: 210;
              hscrollbar-policy: never;

              Gtk.ListBox available_detected_listbox {
                selection-mode: none;
                css-classes: ["boxed-list"];
                margin-start: 10;
                margin-end: 6;
              }
            }

            Gtk.Separator {
              margin-top: 10;
              margin-bottom: 4;
              margin-start: 10;
              margin-end: 6;
            }

            Gtk.Label {
              label: "To be replaced (mapping)";
              css-classes: ["heading"];
              xalign: 0;
              margin-start: 12;
              margin-bottom: 4;
            }

            Gtk.ScrolledWindow {
              vexpand: true;
              hscrollbar-policy: never;

              Gtk.ListBox mapping_old_listbox {
                selection-mode: none;
                css-classes: ["boxed-list"];
                margin-start: 10;
                margin-end: 6;
                margin-bottom: 10;
              }
            }
          }

          [end]
          Gtk.Box palette_column {
            orientation: vertical;
            hexpand: true;

            Gtk.Box {
              orientation: horizontal;
              margin-start: 12;
              margin-top: 10;
              margin-bottom: 4;
              margin-end: 10;

              Gtk.Label {
                label: "New palette";
                css-classes: ["heading"];
                xalign: 0;
                hexpand: true;
              }

              Gtk.DropDown palette_role_filter {
                visible: false;
                valign: center;
                tooltip-text: "Filter by contrast role";
                model: Gtk.StringList {
                  strings ["All", "Foreground only", "Background only", "No role"]
                };
              }
            }

            Gtk.ScrolledWindow {
              height-request: 210;
              hscrollbar-policy: never;

              Gtk.Box palette_left_area {
                orientation: vertical;
                margin-start: 6;
                margin-end: 10;

                Gtk.Box palette_empty_box {
                  orientation: vertical;
                  spacing: 10;
                  vexpand: true;
                  valign: center;
                  halign: center;

                  Gtk.Label {
                    label: "There's no new palette yet.";
                    css-classes: ["dim-label"];
                  }

                  Gtk.Button {
                    action-name: "win.generate-palette";
                    halign: center;
                    css-classes: ["suggested-action", "pill"];
                    child: Adw.ButtonContent {
                      icon-name: "image-x-generic-symbolic";
                      label: "Generate from image…";
                    };
                  }

                  Gtk.Box {
                    orientation: horizontal;
                    spacing: 8;
                    halign: center;

                    Gtk.Button {
                      action-name: "win.import-palette";
                      label: "Import…";
                    }

                    Gtk.Button {
                      action-name: "win.new-palette";
                      label: "New…";
                    }
                  }
                }

                Gtk.ListBox available_palette_listbox {
                  selection-mode: none;
                  css-classes: ["boxed-list"];
                  visible: false;
                }
              }
            }

            Gtk.Button add_color_button {
              visible: false;
              halign: start;
              margin-start: 12;
              margin-top: 6;
              action-name: "win.add-color";
              child: Adw.ButtonContent {
                icon-name: "list-add-symbolic";
                label: "Add color";
              };
            }

            Gtk.Separator {
              margin-top: 10;
              margin-bottom: 4;
              margin-start: 6;
              margin-end: 10;
            }

            Gtk.Label {
              label: "Will replace (mapping)";
              css-classes: ["heading"];
              xalign: 0;
              margin-start: 12;
              margin-bottom: 4;
            }

            Gtk.ScrolledWindow {
              vexpand: true;
              hscrollbar-policy: never;

              Gtk.ListBox mapping_new_listbox {
                selection-mode: none;
                css-classes: ["boxed-list"];
                margin-start: 6;
                margin-end: 10;
                margin-bottom: 10;
              }
            }
          }

          [center]
          Gtk.Box {
            orientation: vertical;
            width-request: 260;
            spacing: 8;
            margin-start: 6;
            margin-end: 6;
            margin-top: 10;

            Gtk.Label mapping_palette_header {
              xalign: 0;
              wrap: true;
              css-classes: ["dim-label", "caption"];
              margin-bottom: 4;
            }

            Gtk.Button palette_image_button {
              css-classes: ["flat"];
              tooltip-text: "Choose an image to preview";

              child: Gtk.Frame {
                css-classes: ["card"];
                height-request: 150;
                overflow: hidden;

                child: Gtk.Box {
                  orientation: vertical;

                  Gtk.Picture palette_image_picture {
                    content-fit: contain;
                    visible: false;
                    vexpand: true;
                  }

                  Gtk.Box palette_image_placeholder {
                    orientation: vertical;
                    spacing: 6;
                    halign: center;
                    valign: center;
                    hexpand: true;
                    vexpand: true;
                    css-classes: ["dim-label"];

                    Gtk.Image {
                      icon-name: "image-x-generic-symbolic";
                      pixel-size: 32;
                    }

                    Gtk.Label {
                      label: "Select an image to show";
                      wrap: true;
                      justify: center;
                      margin-start: 12;
                      margin-end: 12;
                    }
                  }
                };
              };
            }

            Gtk.Separator {
              margin-top: 2;
            }

            Gtk.Label {
              label: "Preview";
              css-classes: ["heading"];
              xalign: 0;
              margin-start: 4;
            }

            Gtk.ScrolledWindow {
              vexpand: true;
              hscrollbar-policy: never;

              Gtk.ListBox mapping_preview_listbox {
                selection-mode: none;
                css-classes: ["boxed-list"];
              }
            }
          }
        }

        Gtk.Revealer warnings_revealer {
          Gtk.Box warnings_box {
            orientation: vertical;
            spacing: 4;
            margin-start: 12;
            margin-end: 12;
            margin-bottom: 8;
          }
        }

        Gtk.Box {
          orientation: horizontal;
          spacing: 8;
          margin-start: 12;
          margin-end: 12;
          margin-bottom: 12;

          Gtk.Label status_label {
            hexpand: true;
            xalign: 0;
            css-classes: ["dim-label"];
            wrap: true;
          }

          Gtk.Button restore_button {
            label: "Restore";
          }

          Gtk.Button test_button {
            label: "Simulate";
          }

          Gtk.Button apply_button {
            label: "Apply";
            css-classes: ["suggested-action"];
            sensitive: false;
          }
        }
      }
    };
  };
}
